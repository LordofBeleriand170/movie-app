generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String   @unique
  emailVerified DateTime?
  role      Roles    @default(USER)
  status    Status   @default(ACTIVE)
  image     String?
  password  String
  sentNotifications     Notification[] @relation("SentNotifications")
receivedNotifications Notification[] @relation("ReceivedNotifications")
  isVerified Boolean @default(false)
  isActive   Boolean @default(false)
  verificationToken String?
  verificationTokenExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bannedUntil DateTime?
  banReason String?


  comments   Comment[]
  replies    Reply[]
  favorite  Favorite[]
  watchlist  Watchlist[]
  ratings    Rating[]
  votes      Voter[]

  commentLikes CommentLike[]
  replyLikes   ReplyLike[]
  recentlyVisited UserRecentlyVisited[]
}

model Notification {
  id         String   @id @default(cuid())
  text       String
  isRead     Boolean  @default(false)

  senderId   String
  sender     User     @relation("SentNotifications", fields: [senderId], references: [id])

  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  receiverId String
  receiver   User     @relation("ReceivedNotifications", fields: [receiverId], references: [id])

  createdAt  DateTime @default(now())
}

model UserRecentlyVisited {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, mediaId])
}

model Favorite {
  id      String @id @default(cuid())
  userId  String
  mediaId Int
  title     String   @default("Unknown")
  poster    String   @default("")
  mediaType MediaType @default(movie)
  releaseDate String

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model Watchlist {
  id      String @id @default(cuid())
  userId  String
  mediaId Int
  title     String   @default("Unknown")
  poster    String   @default("")
  mediaType MediaType @default(movie)
  releaseDate String 

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  username  String
  mediaId   Int
  mediaType MediaType
  text      String
  likes     Int      @default(0)
  rating    Int      @default(0)
  spoilers  Boolean  @default(false)
  replies   Reply[]
  commentLikes CommentLike[]
  isDeleted Boolean @default(false)
  notifications Notification[]
deletedAt DateTime?
deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mediaId, mediaType])
}

model Reply {
  id        String   @id @default(cuid())
  commentId String
  isDeleted Boolean  @default(false)
  comment   Comment  @relation(fields: [commentId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  username  String
  text      String
  likes     Int      @default(0)
  replyLikes ReplyLike[]
  createdAt DateTime @default(now())
}

model CommentLike {
  userId    String
  commentId String
  user      User     @relation(fields: [userId], references: [id])
  comment   Comment  @relation(fields: [commentId], references: [id])
  @@id([userId, commentId])
}

model ReplyLike {
  userId  String
  replyId String
  user    User  @relation(fields: [userId], references: [id])
  reply   Reply @relation(fields: [replyId], references: [id])
  @@id([userId, replyId])
}

model Rating {
  id        String   @id @default(cuid())
  movieId   Int
  mediaType String
  rating    Float    @default(0)
  votes     Int      @default(0)
  voters    Voter[]

  user    User   @relation(fields: [userId], references: [id])
  userId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voter {
  id        String   @id @default(cuid())
  rating    Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratingId  String
  ratingRef Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
}

enum MediaType {
  movie
  tv
}

enum Roles {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  BANNED
  SUSPENDED
}